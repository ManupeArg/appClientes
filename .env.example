# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo la usa el cron de alertas (server)

# Resend (resend.com → API Keys)
RESEND_API_KEY=re_...
EMAIL_FROM="MSP <alertas@tudominio.com>"

# Clave secreta para proteger el endpoint del cron de alertas (inventá una larga)
CRON_SECRET=cambiame-por-algo-largo-y-aleatorio

# URL pública de la app (para links en los mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
